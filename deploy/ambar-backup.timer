[Unit]
Description=AMBAR — копия базы каждый час

[Timer]
# Раз в час. Организация в Atlas заблокирована, и кластер могут погасить без
# предупреждения — сутки работы в такой ситуации терять незачем. Копия весит
# треть мегабайта, прореживание в backup.py оставляет двое суток целиком,
# дальше по копии в день и по воскресеньям.
OnCalendar=hourly
# Сервер мог быть выключен — снимем копию сразу после включения.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
