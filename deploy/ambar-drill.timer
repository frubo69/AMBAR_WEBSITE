[Unit]
Description=AMBAR — проверка восстановления, первого числа каждого месяца

[Timer]
# Копия, которую ни разу не разворачивали, не существует. Раз в месяц ночью
# проверяем это по-настоящему и присылаем результат владельцу.
OnCalendar=*-*-01 03:30:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
