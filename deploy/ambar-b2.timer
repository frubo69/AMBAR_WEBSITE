[Unit]
Description=AMBAR — выгрузка копии наружу, четыре раза в сутки

[Timer]
# Каждые шесть часов. Локальные копии снимаются каждый час, эта — на случай
# потери всего сервера, поэтому реже: свежесть в пределах шести часов здесь
# важнее, чем экономия трёхсот килобайт.
OnCalendar=*-*-* 00,06,12,18:20:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
